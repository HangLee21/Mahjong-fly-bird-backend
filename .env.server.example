# Public HTTPS domain. Point its DNS A/AAAA record at this server first.
SERVER_DOMAIN=api.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Container images can be overridden with an accessible registry mirror.
NODE_BASE_IMAGE=node:20-bookworm-slim
PYTHON_BASE_IMAGE=python:3.12-slim
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7-bookworm
CADDY_IMAGE=caddy:2.8-alpine

# Node packages and Prisma native engines. Mainland servers can use:
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

# Optional build-only proxy. Include the URL scheme and port. These values are
# not injected into the running backend container.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,postgres,redis,ai,backend,caddy

# Use long random alphanumeric values. Avoid URL delimiter characters in these
# two passwords because they are embedded in service connection URLs.
POSTGRES_DB=mahjong
POSTGRES_USER=mahjong
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_ALPHANUMERIC_VALUE
REDIS_PASSWORD=CHANGE_TO_ANOTHER_LONG_RANDOM_ALPHANUMERIC_VALUE

JWT_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d
ADMIN_TOKEN=CHANGE_TO_A_SEPARATE_LONG_RANDOM_TOKEN

WECHAT_APP_ID=CHANGE_TO_WECHAT_APP_ID
WECHAT_APP_SECRET=CHANGE_TO_WECHAT_APP_SECRET
WECHAT_MOCK_LOGIN=false
WECHAT_API_TIMEOUT_MS=5000

AI_DEVICE=cpu
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_WHEEL_URL=https://download.pytorch.org/whl/cpu/torch-2.12.0%2Bcpu-cp312-cp312-manylinux_2_28_x86_64.whl
AI_REQUEST_TIMEOUT_MS=5000
MAX_AI_ACTIONS_PER_TICK=20
ROOM_LOCK_TTL_MS=30000
ROOM_DISCONNECT_GRACE_MS=60000

DEFAULT_RULE_VERSION=qujing-fei-xiaoji-v1.5
DEFAULT_OBSERVATION_VERSION=obs_v1
DEFAULT_ACTION_VERSION=action_v1
LOG_LEVEL=info

# Keep enabled for the current schema-first deployment.
APPLY_DB_SCHEMA=1
SEED_DATABASE=1
